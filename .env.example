# Copy this file to `.env` and adjust only what you need to override.
# Defaults (root user, no password, port 3306) already match a fresh
# XAMPP install and the default `docker compose up -d`, so most people
# won't need a `.env` at all.

# --- Used by docker-compose.yml (host port mapping) ---
# Change if 3306/8081 are already taken on your machine by another project.
DB_PORT=3306
#PMA_PORT=8081

# --- Used by application.properties (Spring Boot datasource) ---
DB_HOST=localhost
DB_NAME=db_Aiperfume
DB_USERNAME=root
DB_PASSWORD=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=perfume-products
R2_PUBLIC_URL=

# --- Used by application.properties (Telegram order/AI notifications) ---
# Opt-in: ONLY one instance/developer should set TELEGRAM_BOT_ENABLED=true,
# since Telegram allows a single long-poll connection per bot token.
# Get these from @BotFather; chat-id is the numeric id of the chat/group that receives notifications.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_CHAT_ID=