# Spring Boot
SERVER=8089

# Password reset OTP email (Gmail SMTP)
GMAIL_USERNAME=your_gmail@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# MySQL
DB_HOST=localhost
DB_PORT=3308
DB_NAME=db_Aiperfume
DB_USERNAME=root
DB_PASSWORD=rootpass

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# Telegram (only one developer should set ENABLED=true)
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:your_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_CHAT_ID=your_chat_id

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=perfume-products
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# Bakong KHQR
BAKONG_ACCOUNT_ID=your_bakong_id@bkrt
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
# Email registered at the Bakong API portal (token auto-renewal)
EMAIL=your_bakong_portal_email@example.com
BAKONG_MERCHANT_NAME=YOUR MERCHANT NAME
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_MOBILE_NUMBER=855XXXXXXXXX
BAKONG_STORE_LABEL=Your Store Label

# Google Sign-In
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com